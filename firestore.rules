rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'ai.kj1207@gmail.com';
    }

    // Check user UID in the admins collection or bootstrapped admin credentials
    function isAdmin() {
      return isBootstrappedAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidStringList(arr, maxLen) {
      return arr is list && arr.size() <= maxLen && (arr.size() == 0 || arr[0] is string);
    }

    function isValidMapList(arr, maxLen) {
      return arr is list && arr.size() <= maxLen && (arr.size() == 0 || arr[0] is map);
    }

    // Entity Validators
    function isValidAdminAccount(data, adminUid) {
      return data.keys().hasAll(['uid', 'email', 'role', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == adminUid && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100))
        && data.role == 'admin'
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdminConfig(data, adminUid) {
      return data.keys().hasAll(['uid', 'pinHash', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'pinHash', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == adminUid && isValidId(data.uid)
        && data.pinHash is string && data.pinHash.size() >= 4 && data.pinHash.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStudentPrivateAccount(data, studentUid) {
      return data.keys().hasAll(['uid', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == studentUid && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStudentProgress(data, studentUid) {
      return data.keys().hasAll([
          'uid', 'studentName', 'level', 'exp', 'targetLevel', 'subLevel',
          'streak', 'currentStageId', 'unlockedStages', 'completedStages',
          'learnedKana', 'bookmarkedKana', 'kanaStats', 'srsItems', 'badges',
          'cultureCards', 'gameRecords', 'studyLogs', 'dailyMissions',
          'missionSettings', 'praiseMessages', 'acknowledgedPraiseIds',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'studentName', 'profileEmoji', 'profileConfigured',
          'diagnosticCompleted', 'diagnosticResult',
          'level', 'exp', 'coins', 'gameExpToday', 'gameExpDate',
          'fontSizeScale', 'lastStudyLocation', 'targetLevel', 'subLevel',
          'streak', 'lastStudyDate', 'streakDates', 'streakProtections',
          'currentStageId', 'unlockedStages', 'completedStages',
          'learnedKana', 'bookmarkedKana',
          'learnedVocab', 'bookmarkedVocab',
          'learnedKanji', 'bookmarkedKanji',
          'learnedGrammar', 'fourWeekPlanChecks',
          'kanaStats', 'srsItems', 'badges',
          'cultureCards', 'mockExamHistory', 'wrongNoteEntries',
          'shopCatalog', 'purchasedItems',
          'gameRecords', 'studyLogs', 'dailyMissions',
          'missionSettings', 'praiseMessages', 'acknowledgedPraiseIds',
          'textbookProgress', 'lastBackupAt', 'startDate', 'createdAt', 'updatedAt'
        ])
        && data.uid is string && data.uid == studentUid && isValidId(data.uid)
        && data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 40
        && (!('profileEmoji' in data) || (data.profileEmoji is string && data.profileEmoji.size() >= 1 && data.profileEmoji.size() <= 16))
        && (!('profileConfigured' in data) || data.profileConfigured is bool)
        && (!('diagnosticCompleted' in data) || data.diagnosticCompleted is bool)
        && (!('diagnosticResult' in data) || data.diagnosticResult == null || (data.diagnosticResult is map && data.diagnosticResult.size() <= 15))
        && data.level is number && data.level >= 1 && data.level <= 200
        && data.exp is number && data.exp >= 0 && data.exp <= 10000000
        && (!('coins' in data) || (data.coins is number && data.coins >= 0 && data.coins <= 10000000))
        && (!('gameExpToday' in data) || (data.gameExpToday is number && data.gameExpToday >= 0 && data.gameExpToday <= 10000))
        && (!('gameExpDate' in data) || (data.gameExpDate is string && data.gameExpDate.size() <= 20))
        && (!('fontSizeScale' in data) || data.fontSizeScale in ['normal', 'large', 'xlarge'])
        && (!('lastStudyLocation' in data) || data.lastStudyLocation == null || (data.lastStudyLocation is map && data.lastStudyLocation.size() <= 15))
        && data.targetLevel in ['STAGE0', 'N5', 'N4', 'N3', 'N2', 'N1']
        && data.subLevel is number && data.subLevel >= 1 && data.subLevel <= 3
        && data.streak is number && data.streak >= 0 && data.streak <= 3650
        && (!('lastStudyDate' in data) || (data.lastStudyDate is string && data.lastStudyDate.size() <= 20))
        && (!('streakDates' in data) || isValidStringList(data.streakDates, 366))
        && (!('streakProtections' in data) || (data.streakProtections is number && data.streakProtections >= 0 && data.streakProtections <= 50))
        && data.currentStageId is string && data.currentStageId.size() >= 1 && data.currentStageId.size() <= 64
        && isValidStringList(data.unlockedStages, 100)
        && isValidStringList(data.completedStages, 100)
        && isValidStringList(data.learnedKana, 300)
        && isValidStringList(data.bookmarkedKana, 300)
        && (!('learnedVocab' in data) || isValidStringList(data.learnedVocab, 500))
        && (!('bookmarkedVocab' in data) || isValidStringList(data.bookmarkedVocab, 500))
        && (!('learnedKanji' in data) || isValidStringList(data.learnedKanji, 500))
        && (!('bookmarkedKanji' in data) || isValidStringList(data.bookmarkedKanji, 500))
        && (!('learnedGrammar' in data) || isValidStringList(data.learnedGrammar, 500))
        && (!('fourWeekPlanChecks' in data) || isValidStringList(data.fourWeekPlanChecks, 100))
        && data.kanaStats is map && data.kanaStats.size() <= 300
        && data.srsItems is map && data.srsItems.size() <= 500
        && isValidStringList(data.badges, 100)
        && isValidStringList(data.cultureCards, 100)
        && (!('mockExamHistory' in data) || isValidMapList(data.mockExamHistory, 100))
        && (!('wrongNoteEntries' in data) || isValidMapList(data.wrongNoteEntries, 200))
        && (!('shopCatalog' in data) || isValidMapList(data.shopCatalog, 50))
        && (!('purchasedItems' in data) || isValidMapList(data.purchasedItems, 100))
        && data.gameRecords is map && data.gameRecords.size() <= 20
        && data.studyLogs is map && data.studyLogs.size() <= 400
        && data.dailyMissions is map && data.dailyMissions.size() <= 20
        && data.missionSettings is map && data.missionSettings.size() <= 20
        && isValidMapList(data.praiseMessages, 50)
        && isValidStringList(data.acknowledgedPraiseIds, 100)
        && (!('textbookProgress' in data) || (data.textbookProgress is map && data.textbookProgress.size() <= 200))
        && (!('lastBackupAt' in data) || (data.lastBackupAt is string && data.lastBackupAt.size() <= 40))
        && (!('startDate' in data) || (data.startDate is string && data.startDate.size() <= 20))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWrongNote(data, expectedStudentUid, entryId) {
      return data.keys().hasAll([
          'id', 'studentUid', 'sourceType', 'level', 'title', 'prompt',
          'options', 'correctIndex', 'pickedIndex', 'explanation', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'studentUid', 'sourceType', 'level', 'title', 'prompt',
          'options', 'correctIndex', 'pickedIndex', 'explanation', 'reasonTag', 'createdAt', 'updatedAt'
        ])
        && data.id is string && data.id == entryId && isValidId(data.id)
        && data.studentUid is string && data.studentUid == expectedStudentUid && isValidId(data.studentUid)
        && data.sourceType in ['kana', 'game', 'reading', 'listening', 'mock', 'kanji', 'vocab']
        && data.level in ['STAGE0', 'N5', 'N4', 'N3', 'N2', 'N1']
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && data.prompt is string && data.prompt.size() >= 1 && data.prompt.size() <= 500
        && data.options is list && data.options.size() <= 10
        && data.correctIndex is number && data.correctIndex >= 0 && data.correctIndex <= 10
        && data.pickedIndex is number && data.pickedIndex >= 0 && data.pickedIndex <= 10
        && data.explanation is string && data.explanation.size() <= 1000
        && (!('reasonTag' in data) || data.reasonTag in ['char_confusion', 'sound_confusion', 'meaning_unknown', 'mistake'])
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Collection: /admins/{adminUid} (Client Read-Only; Registrations strictly via Firebase Console or Admin SDK)
    match /admins/{adminUid} {
      allow get: if isSignedIn() && isValidId(adminUid) && (isOwner(adminUid) || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }

    // Collection: /aiUsage/{usageDocId} (Server-Only, Strictly Protected from all Client-Side Read or Write Access)
    match /aiUsage/{usageDocId} {
      allow read, write: if false;
    }

    // Collection: /adminSettings/{adminUid}
    match /adminSettings/{adminUid} {
      allow get: if isAdmin() && isValidId(adminUid) && isOwner(adminUid);
      allow list: if false;
      allow create: if isAdmin()
        && isValidId(adminUid)
        && isOwner(adminUid)
        && isValidAdminConfig(incoming(), adminUid)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(adminUid)
        && isOwner(adminUid)
        && isValidAdminConfig(incoming(), adminUid)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    // Collection: /students/{studentUid} (Secured strictly to the owner UID or authorized Admin)
    match /students/{studentUid} {
      allow get: if isSignedIn() && isValidId(studentUid) && (isOwner(studentUid) || isAdmin());
      allow list: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);

      allow create: if isVerifiedUser()
        && isValidId(studentUid)
        && (isOwner(studentUid) || isAdmin())
        && isValidStudentProgress(incoming(), studentUid)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(studentUid)
        && isValidStudentProgress(incoming(), studentUid)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Tier 1: Admin Override (mission settings, praise, shop catalog, level assignment, operational management)
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly([
            'studentName', 'profileEmoji', 'profileConfigured',
            'diagnosticCompleted', 'diagnosticResult',
            'level', 'exp', 'coins', 'gameExpToday', 'gameExpDate',
            'fontSizeScale', 'lastStudyLocation', 'targetLevel', 'subLevel',
            'streak', 'lastStudyDate', 'streakDates', 'streakProtections',
            'currentStageId', 'unlockedStages', 'completedStages',
            'learnedKana', 'bookmarkedKana',
            'learnedVocab', 'bookmarkedVocab',
            'learnedKanji', 'bookmarkedKanji',
            'learnedGrammar', 'fourWeekPlanChecks',
            'kanaStats', 'srsItems', 'badges', 'cultureCards',
            'mockExamHistory', 'wrongNoteEntries',
            'shopCatalog', 'purchasedItems',
            'gameRecords', 'studyLogs', 'dailyMissions',
            'missionSettings', 'praiseMessages', 'acknowledgedPraiseIds',
            'textbookProgress', 'lastBackupAt', 'startDate', 'updatedAt'
          ]))
          ||
          // Tier 2: Student Progress Sync (strictly owner-only, cannot alter admin missionSettings, praiseMessages, or shopCatalog)
          (isOwner(studentUid) && incoming().diff(existing()).affectedKeys().hasOnly([
            'studentName', 'profileEmoji', 'profileConfigured',
            'diagnosticCompleted', 'diagnosticResult',
            'level', 'exp', 'coins', 'gameExpToday', 'gameExpDate',
            'fontSizeScale', 'lastStudyLocation', 'targetLevel', 'subLevel',
            'streak', 'lastStudyDate', 'streakDates', 'streakProtections',
            'currentStageId', 'unlockedStages', 'completedStages',
            'learnedKana', 'bookmarkedKana',
            'learnedVocab', 'bookmarkedVocab',
            'learnedKanji', 'bookmarkedKanji',
            'learnedGrammar', 'fourWeekPlanChecks',
            'kanaStats', 'srsItems', 'badges', 'cultureCards',
            'mockExamHistory', 'wrongNoteEntries', 'purchasedItems',
            'gameRecords', 'studyLogs', 'dailyMissions',
            'acknowledgedPraiseIds', 'textbookProgress', 'lastBackupAt', 'startDate', 'updatedAt'
          ]))
        );

      allow delete: if isAdmin() && isValidId(studentUid);

      // Subcollection: /students/{studentUid}/private/{docId} (Isolated PII)
      match /private/{docId} {
        allow get: if isSignedIn()
          && isValidId(studentUid)
          && isValidId(docId)
          && docId == 'account'
          && (isOwner(studentUid) || isAdmin())
          && exists(/databases/$(database)/documents/students/$(studentUid));
        allow list: if false;
        allow create: if isVerifiedUser()
          && isValidId(studentUid)
          && isValidId(docId)
          && docId == 'account'
          && isOwner(studentUid)
          && exists(/databases/$(database)/documents/students/$(studentUid))
          && isValidStudentPrivateAccount(incoming(), studentUid)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isVerifiedUser()
          && isValidId(studentUid)
          && isValidId(docId)
          && docId == 'account'
          && (isOwner(studentUid) || isAdmin())
          && exists(/databases/$(database)/documents/students/$(studentUid))
          && isValidStudentPrivateAccount(incoming(), studentUid)
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'updatedAt']);
        allow delete: if isAdmin() && isValidId(studentUid) && isValidId(docId);
      }

      // Subcollection: /students/{studentUid}/wrongNotes/{entryId} (Student Personal Wrong Notes)
      match /wrongNotes/{entryId} {
        allow get: if isSignedIn()
          && isValidId(studentUid)
          && isValidId(entryId)
          && (isOwner(studentUid) || isAdmin());
        allow list: if isSignedIn()
          && isValidId(studentUid)
          && (isOwner(studentUid) || isAdmin());
        allow create: if isVerifiedUser()
          && isValidId(studentUid)
          && isValidId(entryId)
          && isOwner(studentUid)
          && isValidWrongNote(incoming(), studentUid, entryId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isVerifiedUser()
          && isValidId(studentUid)
          && isValidId(entryId)
          && isOwner(studentUid)
          && isValidWrongNote(incoming(), studentUid, entryId)
          && incoming().studentUid == existing().studentUid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['reasonTag', 'updatedAt']);
        allow delete: if isSignedIn()
          && isValidId(studentUid)
          && isValidId(entryId)
          && (isOwner(studentUid) || isAdmin());
      }
    }

    // Top-level Collection: /wrongNoteEntries/{entryId} (Users only have access to their own UID)
    match /wrongNoteEntries/{entryId} {
      allow get: if isSignedIn()
        && isValidId(entryId)
        && (isOwner(resource.data.studentUid) || isAdmin());
      allow list: if isSignedIn()
        && (resource.data.studentUid == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser()
        && isValidId(entryId)
        && incoming().studentUid == request.auth.uid
        && isValidWrongNote(incoming(), request.auth.uid, entryId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(entryId)
        && incoming().studentUid == request.auth.uid
        && incoming().studentUid == existing().studentUid
        && isValidWrongNote(incoming(), request.auth.uid, entryId)
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['reasonTag', 'updatedAt']);
      allow delete: if isSignedIn()
        && isValidId(entryId)
        && (isOwner(resource.data.studentUid) || isAdmin());
    }
  }
}
