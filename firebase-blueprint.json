{
  "entities": {
    "AdminAccount": {
      "title": "AdminAccount",
      "description": "Authorized administrator registry record",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "maxLength": 254
        },
        "displayName": {
          "type": "string",
          "maxLength": 100
        },
        "role": {
          "type": "string",
          "enum": ["admin"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "role", "createdAt", "updatedAt"]
    },
    "AdminConfig": {
      "title": "AdminConfig",
      "description": "Administrator-only security and preference settings",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "pinHash": {
          "type": "string",
          "minLength": 4,
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "pinHash", "createdAt", "updatedAt"]
    },
    "StudentPrivateAccount": {
      "title": "StudentPrivateAccount",
      "description": "Isolated PII profile for a student user",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "maxLength": 254
        },
        "displayName": {
          "type": "string",
          "maxLength": 100
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "createdAt", "updatedAt"]
    },
    "StudentProgress": {
      "title": "StudentProgress",
      "description": "Non-PII JLPT adventure learning progress, missions, SRS, practice exams, shop, and analytics",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "studentName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "profileEmoji": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16
        },
        "profileConfigured": {
          "type": "boolean"
        },
        "diagnosticCompleted": {
          "type": "boolean"
        },
        "diagnosticResult": {
          "type": "object"
        },
        "level": {
          "type": "number"
        },
        "exp": {
          "type": "number"
        },
        "coins": {
          "type": "number"
        },
        "gameExpToday": {
          "type": "number"
        },
        "gameExpDate": {
          "type": "string",
          "maxLength": 20
        },
        "fontSizeScale": {
          "type": "string",
          "enum": ["normal", "large", "xlarge"]
        },
        "lastStudyLocation": {
          "type": "object"
        },
        "targetLevel": {
          "type": "string",
          "enum": ["STAGE0", "N5", "N4", "N3", "N2", "N1"]
        },
        "subLevel": {
          "type": "number"
        },
        "streak": {
          "type": "number"
        },
        "lastStudyDate": {
          "type": "string",
          "maxLength": 20
        },
        "streakDates": {
          "type": "array"
        },
        "streakProtections": {
          "type": "number"
        },
        "currentStageId": {
          "type": "string",
          "maxLength": 64
        },
        "unlockedStages": {
          "type": "array"
        },
        "completedStages": {
          "type": "array"
        },
        "learnedKana": {
          "type": "array"
        },
        "bookmarkedKana": {
          "type": "array"
        },
        "learnedVocab": {
          "type": "array"
        },
        "bookmarkedVocab": {
          "type": "array"
        },
        "learnedKanji": {
          "type": "array"
        },
        "bookmarkedKanji": {
          "type": "array"
        },
        "learnedGrammar": {
          "type": "array"
        },
        "fourWeekPlanChecks": {
          "type": "array"
        },
        "kanaStats": {
          "type": "object"
        },
        "srsItems": {
          "type": "object"
        },
        "badges": {
          "type": "array"
        },
        "cultureCards": {
          "type": "array"
        },
        "mockExamHistory": {
          "type": "array"
        },
        "wrongNoteEntries": {
          "type": "array"
        },
        "shopCatalog": {
          "type": "array"
        },
        "purchasedItems": {
          "type": "array"
        },
        "gameRecords": {
          "type": "object"
        },
        "studyLogs": {
          "type": "object"
        },
        "dailyMissions": {
          "type": "object"
        },
        "missionSettings": {
          "type": "object"
        },
        "praiseMessages": {
          "type": "array"
        },
        "acknowledgedPraiseIds": {
          "type": "array"
        },
        "textbookProgress": {
          "type": "object"
        },
        "lastBackupAt": {
          "type": "string",
          "maxLength": 40
        },
        "startDate": {
          "type": "string",
          "maxLength": 20
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "studentName",
        "level",
        "exp",
        "targetLevel",
        "subLevel",
        "streak",
        "currentStageId",
        "unlockedStages",
        "completedStages",
        "learnedKana",
        "bookmarkedKana",
        "kanaStats",
        "srsItems",
        "badges",
        "cultureCards",
        "gameRecords",
        "studyLogs",
        "dailyMissions",
        "missionSettings",
        "praiseMessages",
        "acknowledgedPraiseIds",
        "createdAt",
        "updatedAt"
      ]
    },
    "WrongNoteDoc": {
      "title": "WrongNoteDoc",
      "description": "Student wrong answer review note record",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "studentUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "sourceType": {
          "type": "string",
          "enum": ["kana", "game", "reading", "listening", "mock", "kanji", "vocab"]
        },
        "level": {
          "type": "string",
          "enum": ["STAGE0", "N5", "N4", "N3", "N2", "N1"]
        },
        "title": {
          "type": "string",
          "maxLength": 120
        },
        "prompt": {
          "type": "string",
          "maxLength": 500
        },
        "options": {
          "type": "array"
        },
        "correctIndex": {
          "type": "number"
        },
        "pickedIndex": {
          "type": "number"
        },
        "explanation": {
          "type": "string",
          "maxLength": 1000
        },
        "reasonTag": {
          "type": "string",
          "enum": ["char_confusion", "sound_confusion", "meaning_unknown", "mistake"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "studentUid",
        "sourceType",
        "level",
        "title",
        "prompt",
        "options",
        "correctIndex",
        "pickedIndex",
        "explanation",
        "createdAt",
        "updatedAt"
      ]
    },
    "AiUsageDoc": {
      "title": "AiUsageDoc",
      "description": "Server-side daily AI question quota tracking record",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "date": {
          "type": "string",
          "maxLength": 20
        },
        "count": {
          "type": "number"
        },
        "lastQuestionAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "date", "count", "lastQuestionAt", "updatedAt"]
    }
  },
  "firestore": {
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminAccount" },
      "description": "Authorized admin users"
    },
    "/adminSettings/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminConfig" },
      "description": "Admin PIN and private configuration"
    },
    "/students/{studentUid}": {
      "schema": { "$ref": "#/entities/StudentProgress" },
      "description": "Student learning progress and mission settings"
    },
    "/students/{studentUid}/private/{docId}": {
      "schema": { "$ref": "#/entities/StudentPrivateAccount" },
      "description": "Student isolated PII account metadata"
    },
    "/students/{studentUid}/wrongNotes/{entryId}": {
      "schema": { "$ref": "#/entities/WrongNoteDoc" },
      "description": "Student personal wrong answer note entries subcollection"
    },
    "/wrongNoteEntries/{entryId}": {
      "schema": { "$ref": "#/entities/WrongNoteDoc" },
      "description": "Student wrong answer note entries document collection"
    },
    "/aiUsage/{usageDocId}": {
      "schema": { "$ref": "#/entities/AiUsageDoc" },
      "description": "Server-only daily AI quota tracking collection (strictly blocked from all client access)"
    }
  }
}
